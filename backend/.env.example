# Copy to .env for local development. NEVER commit .env.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (pick ONE) ---
# 1) Single URL (Render, Neon, Supabase, Railway ...) - takes priority when set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# 2) Separate Postgres settings:
# DB_NAME=jobcare_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# 3) Local SQLite (default when nothing above is set):
USE_SQLITE=True

# --- Only needed if the frontend is hosted on a different domain (Netlify/Vercel) ---
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
# CSRF_TRUSTED_ORIGINS=https://your-site.netlify.app,https://your-api.onrender.com

# --- Optional ---
# Simulated purchases (no real payment gateway is connected). Keep False outside local demos.
DEMO_PAYMENTS=False
# Only enable for private demos; production builds do not load sample candidate records.
SEED_DEMO_DATA=false
# Razorpay credentials must be stored as environment variables (never committed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Auto-create an admin on deploy (used by build.sh):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
# DJANGO_SUPERUSER_EMAIL=you@example.com
